# Copy to .env and fill in what you need. Never commit .env.
# Every variable is optional unless stated otherwise.

# --- Hypixel -------------------------------------------------------------------------------
# Your own Hypixel API key (https://developer.hypixel.net). Required for profile analysis;
# market features (flips, bazaar, prices, farm builder) work without it. Server-side only:
# the key is never sent to browsers or to the mod. Use one key - no key rotation.
HYPIXEL_API_KEY=2a494893-c626-4274-b714-ed29792c47db

# --- Server --------------------------------------------------------------------------------
# Public origin of the web app (used for CORS, cookies and the device-link URL shown in game).
PUBLIC_WEB_URL=http://localhost:3000
# Host port of the Caddy front proxy in docker compose.
SKYPILOT_PORT=3000
# PostgreSQL password used by docker compose. Change it for anything but local development.
POSTGRES_PASSWORD=skypilot-local-dev
# Running without docker? Point the API at your database / Redis (both optional:
# without DATABASE_URL an in-memory store is used and data is lost on restart).
# DATABASE_URL=postgres://skypilot:skypilot-local-dev@localhost:5432/skypilot
# REDIS_URL=redis://localhost:6379
# Set to 1 only when the API sits behind a trusted reverse proxy (X-Forwarded-For).
# TRUST_PROXY=0
# Secure cookies are enabled automatically when PUBLIC_WEB_URL is https.
# COOKIE_SECURE=1
# Market collector inside the API process (embedded | disabled).
# COLLECTOR_MODE=embedded
# Hours between Hypixel resources / NEU-REPO refreshes, and days of history loaded at start.
# DATA_REFRESH_HOURS=24
# WARM_START_DAYS=7

# --- Web Push ------------------------------------------------------------------------------
# VAPID key for flip-alert notifications. Generate with `skypilot-api vapid-keys`. When unset,
# a key is generated once and stored in data/cache/vapid_private.key.
# VAPID_PRIVATE_KEY=
# Contact for push services (mailto: or https: URL). Defaults to PUBLIC_WEB_URL.
# VAPID_SUBJECT=mailto:you@example.com
# WEB_PUSH=1

# --- Assistant (optional) -------------------------------------------------------------------
# Claude only rephrases answers computed from SkyPilot's data; it never supplies prices,
# requirements, recipes, drop rates or XP. Without a key the assistant answers deterministically.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Chat translation for the mod (optional) ------------------------------------------------
# Without a provider only the built-in SkyBlock phrase dictionary is used.
# TRANSLATION_PROVIDER=deepl            # deepl | libretranslate | claude
# DEEPL_API_KEY=
# LIBRETRANSLATE_URL=http://localhost:5000
# Players can instead pick their own provider and key in Settings (web) or the mod's settings
# screen. Those keys are stored AES-256-GCM encrypted with this server secret (base64, 32 bytes;
# generate with `openssl rand -base64 32`). When unset, a secret is generated once and kept in
# data/cache/secret.key; losing it only means players have to enter their keys again.
# SKYPILOT_SECRET_KEY=
