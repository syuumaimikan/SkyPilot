# Single entry point: /api (REST + WebSocket) → Rust API, everything else → Next.js.
# Same origin for the browser, so the session cookie and CSRF token just work.
:80 {
	encode zstd gzip

	# Native Android updates share the same private HTTPS origin as the app.
	handle_path /api/android/* {
		root * /srv/android
		header Cache-Control "no-store"
		file_server
	}

	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:3000
	}
}
