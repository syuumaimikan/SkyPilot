<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="64dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="8dp">
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_skypilot" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="4dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text" />
            <TextView android:id="@+id/connection_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/companion" android:textSize="10sp" android:singleLine="true" android:ellipsize="end" android:letterSpacing="0.07" android:textColor="@color/muted" />
        </LinearLayout>
        <ImageButton android:id="@+id/refresh" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_refresh" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/refresh" />
        <ImageButton android:id="@+id/menu" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_menu" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/connection_settings" />
    </LinearLayout>
    <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:visibility="gone" />
    <FrameLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <FrameLayout android:id="@+id/web_container" android:layout_width="match_parent" android:layout_height="match_parent" />
        <ScrollView android:id="@+id/error_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@drawable/onboarding_background" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="28dp">
                <dev.skypilot.android.OrbitView android:layout_width="match_parent" android:layout_height="160dp" />
                <TextView android:id="@+id/error_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/connection_failed" android:textSize="25sp" android:textStyle="bold" android:textColor="@color/text" android:gravity="center" />
                <TextView android:id="@+id/error_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/connection_failed_help" android:textColor="@color/muted" android:textSize="15sp" android:lineSpacingExtra="5dp" android:gravity="center" />
                <Button android:id="@+id/retry" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="28dp" android:background="@drawable/primary_button" android:backgroundTint="@null" android:textColor="#11182C" android:text="@string/retry" />
                <Button android:id="@+id/error_settings" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="?android:attr/selectableItemBackground" android:textColor="@color/muted" android:text="@string/connection_settings" />
            </LinearLayout>
        </ScrollView>
        <ScrollView android:id="@+id/setup" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@drawable/onboarding_background">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:paddingTop="8dp">
                <dev.skypilot.android.OrbitView android:layout_width="match_parent" android:layout_height="160dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/welcome" android:textSize="34sp" android:textStyle="bold" android:textColor="@color/text" android:lineSpacingExtra="3dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/intro" android:textSize="15sp" android:lineSpacingExtra="5dp" android:textColor="@color/muted" android:layout_marginTop="14dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/features" android:textSize="12sp" android:textColor="@color/accent" android:lineSpacingExtra="7dp" android:layout_marginTop="20dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/panel_background" android:padding="20dp" android:layout_marginTop="28dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/connect_title" android:textSize="19sp" android:textStyle="bold" android:textColor="@color/text" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/private_connection" android:textSize="12sp" android:textColor="@color/muted" android:layout_marginTop="6dp" />
                    <RadioGroup android:id="@+id/connection_mode" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:checkedButton="@id/mode_tailscale" android:layout_marginTop="20dp">
                        <RadioButton android:id="@+id/mode_tailscale" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:button="@null" android:background="@drawable/mode_background" android:gravity="center" android:text="@string/tailscale_mode" android:textColor="@color/text" android:textSize="13sp" />
                        <RadioButton android:id="@+id/mode_local" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="8dp" android:button="@null" android:background="@drawable/mode_background" android:gravity="center" android:text="@string/local_mode" android:textColor="@color/text" android:textSize="13sp" />
                    </RadioGroup>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:labelFor="@id/server_url" android:text="@string/server_label" android:textSize="12sp" android:textColor="@color/muted" android:layout_marginTop="20dp" />
                    <EditText android:id="@+id/server_url" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="8dp" android:background="@drawable/input_background" android:paddingStart="14dp" android:paddingEnd="14dp" android:inputType="textUri" android:singleLine="true" android:imeOptions="actionGo" android:autofillHints="url" android:textSize="16sp" android:textColor="@color/text" android:textColorHint="@color/muted" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/server_hint" android:textSize="11sp" android:textColor="@color/muted" android:layout_marginTop="8dp" />
                    <TextView android:id="@+id/mode_help" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/server_help" android:textSize="12sp" android:lineSpacingExtra="4dp" android:textColor="@color/muted" android:layout_marginTop="16dp" />
                    <TextView android:id="@+id/debug_help" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/debug_help" android:textSize="12sp" android:textColor="@color/muted" android:layout_marginTop="12dp" android:visibility="gone" />
                    <Button android:id="@+id/connect" android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/connect" android:textSize="15sp" android:textStyle="bold" android:textColor="#11182C" android:background="@drawable/primary_button" android:backgroundTint="@null" android:layout_marginTop="24dp" />
                    <Button android:id="@+id/tailscale_guide" android:layout_width="match_parent" android:layout_height="48dp" android:background="?android:attr/selectableItemBackground" android:textColor="@color/accent" android:textSize="12sp" android:text="@string/tailscale_guide" android:layout_marginTop="8dp" />
                    <Button android:id="@+id/cancel_setup" android:layout_width="match_parent" android:layout_height="48dp" android:background="?android:attr/selectableItemBackground" android:textColor="@color/muted" android:text="@string/cancel" android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
